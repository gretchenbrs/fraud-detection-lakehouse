              "query": {
                "datasetName": "queue_audit",
                "fields": [
                  {"name": "priority_tier", "expression": "`priority_tier`"},
                  {"name": "queue_count", "expression": "`queue_count`"},
                  {"name": "captured_fraud_count", "expression": "`captured_fraud_count`"},
                  {"name": "audit_precision", "expression": "`audit_precision`"},
                  {"name": "captured_fraud_exposure_amount", "expression": "`captured_fraud_exposure_amount`"}
