        }
      ]
    },
    {
      "name": "retrospective_audit",
      "displayName": "Retrospective Audit",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "audit_header",
            "multilineTextboxSpec": {
              "lines": [
                "# Retrospective Queue Audit\n",
                "\n",
                "Post-outcome evaluation only. These labels must never be used for operational prioritization or model selection."
              ]
            }
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 2}
        },
        {
          "widget": {
            "name": "audit_precision_chart",
            "queries": [{
              "name": "main_query",
              "query": {
                "datasetName": "queue_audit",
                "fields": [
                  {"name": "priority_tier", "expression": "`priority_tier`"},
                  {"name": "audit_precision", "expression": "`audit_precision`"}
                ],
                "disaggregated": true
