                  {"fieldName": "audit_precision", "displayName": "Audit Precision", "format": {"type": "number-percent"}},
                  {"fieldName": "captured_fraud_exposure_amount", "displayName": "Captured Exposure Proxy", "format": {"type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 2}}}
                ]
              },
              "frame": {"showTitle": true, "title": "Audit Detail"}
            }
          },
          "position": {"x": 6, "y": 2, "width": 6, "height": 6}
        }
      ]
    }
  ],
  "uiSettings": {
